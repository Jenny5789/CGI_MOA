# 이 파일을 .env.local 로 복사해서 고친다 (.env.local 은 Git에 올라가지 않는다)

# 어느 서버에 보낼지
# - mock  : 모두 가짜 서버(src/api/mock.js). 서버 없이 화면만 볼 때
# - mixed : 실제 서버(backend/)에 있는 기능은 실제 서버로, 나머지는 가짜 서버로
#           지금은 로그인·사진 올리기·추출·합성·사진첩 모두 실제 서버에 있음 (실제 서버 시험 계정 test / test1234)
# - real  : 모두 실제 서버로
VITE_API_MODE=mock

# 실제 서버 주소 (mixed, real 일 때 쓰임)
VITE_API_TARGET=http://localhost:8000
