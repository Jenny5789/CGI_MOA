# 한 PC 실행 설정값. 바꿀 값이 있을 때만 .env로 복사해 수정, .env는 Git 제외
# 비워 두면 docker-compose.yml의 기본값 사용

# 합성 가중치 Hugging Face 저장소 이름
MOA_WEIGHTS_REPO=
# 저장소가 이용 조건 동의 후 받기로 설정된 경우 Hugging Face 읽기 토큰
HF_TOKEN=

# 화면 접속 포트
WEB_PORT=8080

# 1이면 부품 단위 GPU 적재, VRAM 10GB 미만 GPU용. 합성 시간 증가
MODEL_SAVE_MEMORY=0

# DB 비밀번호. 영문·숫자만, DB 포트는 외부에 열지 않음
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
