# 도커 실행 설정 본보기 (docker-compose.yml 이 읽음)
# 사용: 이 파일을 .env 로 복사한 뒤 경로를 내 PC에 맞게 고친다 (.env 는 git에 올라가지 않음)
#   PowerShell, 프로젝트 맨 위 폴더에서: Copy-Item .env.docker.example .env
# 경로는 C:/Users/... 처럼 / 로 적는다 (\ 쓰지 않음)

# (필수) AnyDoor 가중치 폴더. 안에 epoch=1-step=8687.ckpt, dinov2_vitg14_pretrain.pth 가 있어야 한다
ANYDOOR_WEIGHTS_DIR=C:/Users/AISW_203_103/Desktop/AnyDoor/checkpoints

# (선택) SAM2 가중치 폴더. 안에 sam2.1_hiera_base_plus.pt 가 있어야 한다. 기본값은 프로젝트 안 ./checkpoints/sam2
# SAM2_WEIGHTS_DIR=./checkpoints/sam2

# (선택) 0 이면 서버 시작 때 AnyDoor 모델 로딩·예열(1~2분)을 건너뛴다. 합성을 안 쓸 때만. 기본 1
# MOA_WARMUP=1

# (선택) 화면의 API 모드. 빌드할 때 굳으므로 바꾸면 docker compose up --build -d 로 다시 빌드. 기본 mixed
# VITE_API_MODE=mixed

# (선택) 화면이 열리는 PC 쪽 포트. 기본 5180
# WEB_PORT=5180
