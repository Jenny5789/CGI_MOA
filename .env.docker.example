# docker compose 설정 예시. 복사해서 .env 로 만들고 값을 채운다 (.env 는 git에 올리지 않음)
# 경로는 / 로 쓴다 (예: C:/Users/...)

# AnyDoor 추론용 가중치 폴더 (epoch=1-step=8687.ckpt, dinov2_vitg14_pretrain.pth)
ANYDOOR_WEIGHTS_DIR=C:/Users/사용자/Desktop/CGI_V2/checkpoints/anydoor
# SAM2 가중치 폴더 (sam2.1_hiera_base_plus.pt)
SAM2_WEIGHTS_DIR=./checkpoints/sam2

# MySQL. 비밀번호는 영문과 숫자만 (접속 주소에 들어가므로 @ : / 같은 기호를 쓰면 안 됨)
MYSQL_DATABASE=cgi
MYSQL_USER=cgi_app
MYSQL_PASSWORD=change_me_app
MYSQL_ROOT_PASSWORD=change_me_root