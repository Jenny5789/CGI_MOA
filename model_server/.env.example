# 모델 추론 서버 compose 설정값. 필요할 때만 .env로 복사해 수정, .env는 Git 제외
# 비워 두면 docker-compose.yml의 기본값 사용

# 16비트 합성 가중치 폴더와 사용할 파일. scripts/convert_weights_fp16.py로 생성
WEIGHTS_DIR=../checkpoints/weights
ANYDOOR_WEIGHT=official_fp16.ckpt

# SAM2 가중치 폴더, sam2.1_hiera_base_plus.pt 포함
SAM2_DIR=../checkpoints/sam2

# 초해상도 가중치 폴더와 파일. Real-ESRGAN 공식 릴리스 v0.2.1의 RealESRGAN_x2plus.pth
# 파일이 없으면 초해상도 없이 합성
UPSCALE_DIR=../checkpoints/realesrgan
UPSCALE_WEIGHT=RealESRGAN_x2plus.pth

# 요청 토큰. 설정 시 웹 서비스 서버 deploy/.env의 MODEL_TOKEN에도 같은 값
MODEL_TOKEN=

# 공개 포트
MODEL_PORT=8100

# 1이면 부품 단위 GPU 적재, VRAM 10GB 미만 GPU용
MODEL_SAVE_MEMORY=0
