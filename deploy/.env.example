# docker compose 설정값. 이 파일을 .env로 복사해 값 입력, .env는 Git 제외
# 비밀번호는 영문·숫자만: DB 접속 주소 안에 들어가므로 @ : / 같은 기호 사용 불가

MYSQL_DATABASE=moa
MYSQL_USER=moa
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 모델 추론 서버 주소
# - 학교 VM: 모델 추론 서버가 실행 중인 개발 PC 주소
# - 개발 PC에서 시험: http://host.docker.internal:8100
MODEL_SERVER_URL=http://192.168.24.106:8100
# 모델 추론 서버에 MODEL_TOKEN을 설정한 경우 같은 값
MODEL_TOKEN=

# 화면 접속 포트
WEB_PORT=8080
